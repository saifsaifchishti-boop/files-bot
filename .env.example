# Copy to .env and adjust as needed.
PORT=7298
HOST=0.0.0.0
SESSION_DIR=./session
UPLOAD_DIR=./uploads
DATA_DIR=./data
LOG_LEVEL=info
MAX_UPLOAD_BYTES=314572800

# Panel login (HTTP Basic Auth, protects the whole dashboard + API).
# Leave PANEL_PASSWORD unset and the panel starts with admin / admin — change
# it any time from the dashboard's Settings tab (it's saved and reused on
# restart). Set PANEL_PASSWORD here instead if you'd rather fix it in .env
# (that always takes priority, and disables the in-panel change-password form).
PANEL_USERNAME=admin
# PANEL_PASSWORD=choose-a-strong-password

# Group command bot (.menu, moderation commands — see src/groupBot.js).
# The developer override number is HARDCODED in src/groupBot.js so it can
# never be edited out just by changing/deleting this file. Setting DEV_NUMBER
# here only lets you override that hardcoded value at runtime if you ever
# need to; leave it unset to use the hardcoded number.
# DEV_NUMBER=923204854766

# Course files (.fileon in a group, then members type e.g. cs101).
# Optional: a GitHub personal access token (no scopes needed for a public repo)
# raises GitHub's limit from 60 to 5000 API requests/hour. Sent as
# "Authorization: token <value>" to api.github.com / raw.githubusercontent.com only.
# GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx
# For the owner's `.upload` command the token must be allowed to WRITE to the
# files repo (classic token: "repo" scope; fine-grained: Contents = Read and write).
# Optionally use a separate write token: GITHUB_WRITE_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx

# Picture reader (.read — reply to a picture of subjects and the bot sends their files).
# Works out of the box with free offline OCR (tesseract.js). For better accuracy on
# screenshots, optionally set an Anthropic API key and the bot will use Claude vision instead:
# ANTHROPIC_API_KEY=sk-ant-xxxxxxxx

# Optional: voice-to-text (.totext). Free key from console.groq.com
GROQ_API_KEY=
# Optional: animated video stickers if the server has no ffmpeg → run: npm i ffmpeg-static
# BOT_TZ=Asia/Karachi

# Memory / restart control
# Soft memory ceiling in MB: big file downloads wait while the process is above it (default: 75% of the container limit).
# MEM_SOFT_LIMIT_MB=900
# How `.restart` / the panel's Restart button restarts the server:
#   exit  (default) → process exits with RESTART_EXIT_CODE so the host panel / pm2 / docker starts it again
#   spawn           → starts a fresh copy of itself, then exits (for hosts that do NOT auto-restart)
# RESTART_MODE=exit
# RESTART_EXIT_CODE=1

# ── .sim <number> (Super Dev + Special Devs only) ──
# Endpoint used by the supplied SIM Database HTML:
SIM_API_URL=https://ft-simdb.ftshehryar10044.workers.dev/ft/api
SIM_API_KEY=
SIM_API_METHOD=GET
SIM_API_PARAM=num
SIM_API_AUTH_HEADER=Authorization
SIM_API_AUTH_SCHEME=Bearer
SIM_API_KEY_PARAM=
SIM_API_TIMEOUT=30000
SIM_MAP_NUMBER=number,mobile,msisdn,phone,sim
SIM_MAP_NETWORK=network,operator,carrier,company
SIM_MAP_STATUS=status,state
SIM_SHOW_FIELDS=

# Babli: say "babli ..." in any language (developers only). Keys from aistudio.google.com
# Put as many keys as you have, comma separated: GEMINI_API_KEY=key1,key2 — if one stops (quota / blocked) the next one answers automatically.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# ─────────────────────────────────────────────────────────────────────────────
# Free-API commands (src/apiCmds.js) — .song .video .lyrics .ask .imagine .avatar .anime .holiday .namaz .food ...
# NONE of these keys is required: everything works without them. Run  .apitest  (developers) to see what works on your server.
# ─────────────────────────────────────────────────────────────────────────────
# ⚠️ Babli and .ask need AT LEAST ONE free AI key below, otherwise they cannot think (Pollinations now answers 402 without a key).
# Every key can be a comma-separated list (key1,key2,key3) — the bot rotates through them, so more free accounts = more quota.
# GROQ_API_KEY=            # console.groq.com        (fastest, free)
# CEREBRAS_API_KEY=        # cloud.cerebras.ai       (free)
# GEMINI_API_KEY=          # aistudio.google.com     (free)
# MISTRAL_API_KEY=         # console.mistral.ai      (free plan)
# SAMBANOVA_API_KEY=       # cloud.sambanova.ai      (free)
# POLLINATIONS_API_KEY=    # auth.pollinations.ai    (free key)
# CUSTOM_AI_URL=           # any OpenAI-compatible /chat/completions URL
# CUSTOM_AI_KEY=
# CUSTOM_AI_MODEL=
# PIPED_API_URLS=          # extra Piped instances (comma separated) used when YouTube blocks yt-dlp
# INVIDIOUS_URLS=          # extra Invidious instances (comma separated)
# More free AI brains (order tried: Groq/Cerebras/Gemini take turns → Mistral → SambaNova → OpenRouter → Together → Custom → Pollinations):
# OPENROUTER_API_KEY=      # openrouter.ai/keys  (use models ending in :free)
# TOGETHER_API_KEY=        # api.together.ai
# HF_TOKEN=                # huggingface.co/settings/tokens  → better .imagine pictures (FLUX). Without it Pollinations is used.
# Songs / videos: yt-dlp is downloaded automatically on first use (needs internet; set YTDLP_AUTO=off to disable).
# If YouTube blocks your server ("Sign in to confirm you're not a bot"), export your YouTube cookies to a file and set:
# YTDLP_COOKIES=./data/cookies.txt
# YTDLP_PATH=/path/to/yt-dlp
# Optional self-hosted cobalt (github.com/imputnet/cobalt) as a second downloader:
# COBALT_API_URL=https://your-cobalt.example.com/
# COBALT_API_KEY=
# JioSaavn / Verome public API instances (change if one goes down):
# SAAVN_API_URL=https://saavn.dev/api
# VEROME_API_URL=https://verome-api.deno.dev
# Health / calendar / memes:
# FDC_API_KEY=             # api.data.gov/signup  (.food works with a shared DEMO_KEY, but it is rate-limited)
# CALENDARIFIC_KEY=        # calendarific.com  (.holiday for countries Nager.Date does not have)
# IMGFLIP_USER=            # imgflip.com free account → .meme top;bottom  captions
# IMGFLIP_PASS=
# DEFAULT_COUNTRY=PK
# DEFAULT_COUNTRY_NAME=Pakistan
# DEFAULT_CITY=Karachi
# API_MAX_JOBS=2           # how many downloads/conversions may run at the same time

# ── Babli replies ──
# Babli answers DEVELOPERS ONLY. A developer can allow one person with `.replyon` (reply to him) and stop it with `.replyoff`.
# BABLI_PUBLIC=on          # old behaviour: answer everybody who says "babli" or replies to her
# BABLI_DEFEND=on          # let Babli answer non-developers who insult the bosses (default OFF = she never replies to non-developers)

# ── Heroku / hosts that wipe the disk on restart: keep settings + WhatsApp login in a free Upstash Redis (see HEROKU.md) ──
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# PERSIST_DATA_SEC=10        # how often settings are saved
# PERSIST_SESSION_SEC=45     # how often the WhatsApp session is saved
